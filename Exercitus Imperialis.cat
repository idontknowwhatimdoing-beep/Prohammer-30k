<rule id="0a44-b5ba-5c88-6316" name="Advanced Weapons (Survivors of the Dark Age)" hidden="false">
<description>+1 Strength to all laspistols, hellpistols, lasguns, lascarbines, laslocks and hellguns carried by the squad. If one squad of a type buys it, every eligible squad of that type in the army must.</description>
</rule>
</rules>
<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="20" />
</costs>
