<characteristic name="AP" typeId="964e-6f66-dcaa-247a">5</characteristic>
<characteristic name="Type" typeId="54df-9f85-8d55-7440">Pistol</characteristic>
</characteristics>
</profile>
<profile id="eec5-c1a2-c7c9-84c1" name="Hellpistol" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">12"</characteristic>
<characteristic name="S" typeId="6204-806b-a18a-c0be">3</characteristic>
<characteristic name="AP" typeId="964e-6f66-dcaa-247a">5</characteristic>
<characteristic name="Type" typeId="54df-9f85-8d55-7440">Pistol</characteristic>
</characteristics>
</profile>
<profile id="0a22-2074-6348-ef8b" name="Hand Flamer" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">Template</characteristic>
<characteristic name="S" typeId="6204-806b-a18a-c0be">3</characteristic>
<characteristic name="AP" typeId="964e-6f66-dcaa-247a">6</characteristic>
<characteristic name="Type" typeId="54df-9f85-8d55-7440">Pistol</characteristic>
</characteristics>
</profile>
<profile id="0e6f-9ff2-5fff-234c" name="Needle Pistol" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">12"</characteristic>
<characteristic name="S" typeId="6204-806b-a18a-c0be">2</characteristic>
<characteristic name="AP" typeId="964e-6f66-dcaa-247a">5</characteristic>
<characteristic name="Type" typeId="54df-9f85-8d55-7440">Pistol, Poisoned, Rending</characteristic>
</characteristics>
</profile>
<profile id="8109-afa5-1609-869a" name="Plasma Pistol" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">12"</characteristic>
<characteristic name="S" typeId="6204-806b-a18a-c0be">7</characteristic>
<characteristic name="AP" typeId="964e-6f66-dcaa-247a">2</characteristic>
<characteristic name="Type" typeId="54df-9f85-8d55-7440">Pistol, Gets Hot</characteristic>
</characteristics>
</profile>
<profile id="60f9-e7a4-68e3-eec9" name="Autogun" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
