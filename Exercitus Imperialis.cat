</characteristics>
</profile>
<profile id="5f3b-a070-9db3-da49" name="Bolt Pistol" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">12"</characteristic>
