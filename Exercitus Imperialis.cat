<rules>
<rule id="ef7b-308f-8a8c-109d" name="Grav-chutes (Drop Assault Regiments)" hidden="false">
<description>Every model has a Grav-chute: the unit may not select a Dedicated Transport, may always be placed in Reserve and may Deep Strike; it may not begin the battle embarked.</description>
</rule>
</rules>
