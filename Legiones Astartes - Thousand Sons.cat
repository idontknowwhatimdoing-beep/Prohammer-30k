<infoLinks>
<infoLink id="3787-00da-be12-78cf" name="Black Staff of Ahriman" hidden="false" targetId="9af5-b7f3-2de0-5762" type="profile" />
<infoLink id="78af-8e74-d6dd-855b" name="Black Staff of Ahriman" hidden="false" targetId="39bf-28b7-9cf3-dd7d" type="rule" />
