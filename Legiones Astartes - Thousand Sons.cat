<selectionEntry id="e5d5-75b6-e116-6bcb" name="Osiron Force Blade" hidden="false" collective="false" import="true" type="upgrade">
<infoLinks>
<infoLink id="00a9-7d49-716a-c653" name="Osiron Force Blade" hidden="false" targetId="096f-8dfd-a73f-7c03" type="profile" />
