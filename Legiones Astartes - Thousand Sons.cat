</conditions>
</modifier>
<modifier type="add" field="error" value="An army may never include both the mortal and the Shard form of Magnus.">
<conditions>
<condition field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="8ad0-7cbc-d8d8-025e" type="atLeast" />
</conditions>
</modifier>
<modifier type="add" field="error" value="Magnus, Shard of the Crimson King is Traitor only.">
<conditions>
<condition field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="af50-de01-cc93-f43e" type="atLeast" />
</conditions>
