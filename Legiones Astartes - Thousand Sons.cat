<infoLinks>
<infoLink id="1270-6f24-4491-cb3f" name="Blade of Ahn-Nunurta" hidden="false" targetId="26f1-9f97-8e25-82e9" type="profile" />
<infoLink id="4ed4-4e05-57da-91ac" name="Blade of Ahn-Nunurta" hidden="false" targetId="193e-e99f-ddcb-60b7" type="rule" />
