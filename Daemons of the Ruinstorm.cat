<selectionEntry id="de89-2332-d812-d2ad" name="Sword of Six Thousand Miseries" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="38ee-dcea-bfcc-1328" name="Sword of Six Thousand Miseries" hidden="false">
<description>Attacks made with the Sword of Six Thousand Miseries count as attacks made with a Force Weapon and have the Rending special rule.</description>
</rule>
</rules>
