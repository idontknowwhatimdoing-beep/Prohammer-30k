<selectionEntry id="880e-4c5e-3449-9f75" name="Blades of Samus" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="41b5-9694-b84e-589e" name="Blades of Samus" hidden="false">
<description>Attacks made with the Blades of Samus count as Power Weapon attacks and have Rending and Armourbane.</description>
</rule>
</rules>
<infoLinks>
