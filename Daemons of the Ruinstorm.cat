<selectionEntry id="0d2e-8c76-21e8-f31d" name="Noxious Maw" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="0697-3ea0-138f-1a5a" name="Noxious Maw" hidden="false">
<description>Attacks made with the Noxious Maw count as Power Weapon attacks. When attacking Infantry, Jump Infantry, Bikes or Cavalry, natural To Hit rolls of 5 or 6 inflict Instant Death if the resulting Wound is not saved. Models immune to Instant Death remain immune.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="ca0d-f321-2ea9-56a6" name="Noxious Maw" hidden="false" targetId="3d8e-58ed-cc7a-6845" type="profile" />
</infoLinks>
<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="0" />
</costs>
