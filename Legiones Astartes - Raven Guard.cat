<selectionEntry id="5e99-3fba-c8be-72c1" name="Wrath &amp; Justice" hidden="false" collective="false" import="true" type="upgrade">
<infoLinks>
<infoLink id="871e-3068-53f8-127f" name="Wrath &amp; Justice" hidden="false" targetId="3267-9620-fd67-f0ea" type="profile" />
<infoLink id="f7f7-dbb6-82f5-833f" name="Rending" hidden="false" targetId="59e9-d133-77f2-ca5a" type="rule" />
