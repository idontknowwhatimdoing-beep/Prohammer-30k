<profile id="d4a4-4df6-bf5e-f722" name="Rotor Cannon" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">30"</characteristic>
