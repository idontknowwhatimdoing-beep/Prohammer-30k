<selectionEntry id="fed8-0d6a-1c16-ed8f" name="Proteus Neuro-Lash" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="44db-8ae9-61ef-b58b" name="Proteus Neuro-Lash" hidden="false">
<description>Strength +1, Two-handed. Electro-arc: for every successful hit, roll a D6; on a 3+ the target suffers one additional Poisoned (4+) hit. Sweeping Strikes: instead of her normal Attacks characteristic, the bearer may make a number of attacks equal to the number of enemy models within 3" engaged in the same combat.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="767f-acac-42f1-47a4" name="Proteus Neuro-Lash" hidden="false" targetId="ec32-24b0-bfff-62f5" type="profile" />
