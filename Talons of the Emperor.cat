<cost name="pts" typeId="pts0-0000-0000-0001" value="0" />
</costs>
</selectionEntry>
<selectionEntry id="6cfc-898a-0164-0251" name="Sympatic Dataspikes" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="918a-a232-5240-2422" name="Sympatic Dataspikes" hidden="false">
<description>Close combat weapons with Rending and Concussive. The Vanus receives +2 Attacks when fighting with them.</description>
</rule>
</rules>
