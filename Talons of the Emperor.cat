</costs>
</selectionEntry>
<selectionEntry id="9bf7-2fa1-c276-0a8a" name="Tarsus Buckler" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="bc66-2376-865e-6394" name="Tarsus Buckler" hidden="false">
<description>Counts as a +1 Strength Power Weapon. Energy Nullifier: Power Weapons and Lightning Claws do not negate the bearer's normal Armour Save (no effect against Power Fists, Thunder Hammers or similarly powerful weapons).</description>
</rule>
</rules>
<infoLinks>
<infoLink id="7baa-42b1-a575-9a5f" name="Tarsus Buckler" hidden="false" targetId="8abe-5829-a393-0a4b" type="profile" />
</infoLinks>
<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="0" />
</costs>
</selectionEntry>
<selectionEntry id="2af7-92de-fb8a-ab63" name="Solarite Power Lance" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="519e-aec8-73f0-98c6" name="Solarite Power Lance" hidden="false">
<description>Counts as a Power Weapon. On a turn in which the bearer charges, he may resolve up to two of his normal close combat attacks at Initiative 10; these are resolved at Strength 8 and have Armourbane. Remaining attacks are resolved normally. In subsequent rounds it simply counts as a Power Weapon.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="1878-0c65-8110-3082" name="Solarite Power Lance" hidden="false" targetId="2f51-c639-f95b-446e" type="profile" />
