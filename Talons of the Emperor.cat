<selectionEntry id="d0e7-1822-39d1-e272" name="Executioner Pistol" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="921f-5fd8-57c4-e258" name="Executioner Pistol" hidden="false">
<description>Fire either profile. The Needle Pistol profile always wounds non-vehicle models on a 4+; against vehicles roll a single D6 for Armour Penetration.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="5e97-980f-89a3-a7a5" name="Executioner Pistol - Bolt Pistol" hidden="false" targetId="5074-6fda-a630-6ff1" type="profile" />
