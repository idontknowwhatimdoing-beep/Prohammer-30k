</rule>
</rules>
<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="0" />
</costs>
</selectionEntry>
<selectionEntry id="b4e0-e11a-3c9c-cde1" name="Voidsheen Cloak" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="80d6-01dc-a53e-6dd2" name="Voidsheen Cloak" hidden="false">
