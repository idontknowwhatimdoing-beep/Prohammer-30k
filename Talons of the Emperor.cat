<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="0" />
</costs>
</selectionEntry>
<selectionEntry id="5ec1-65e4-6c2b-111e" name="Needlespine Blaster" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="0499-b729-5da8-8953" name="Needlespine Blaster" hidden="false">
<description>Fire either profile. PHAGE: a model suffering one or more unsaved wounds from the Needlespine Launcher reduces its Toughness by 1 for the rest of the battle (minimum 1, does not stack).</description>
</rule>
</rules>
<infoLinks>
<infoLink id="63c4-ff2a-4478-2e69" name="Needlespine Blaster - Bolt Pistol" hidden="false" targetId="e561-a0a1-86ec-d1b7" type="profile" />
