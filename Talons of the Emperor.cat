</costs>
</selectionEntry>
<selectionEntry id="4c2e-391b-ba4f-3d41" name="Pair of Solarite Power Talons" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="1a6e-57e6-5610-e8f2" name="Pair of Solarite Power Talons" hidden="false">
<description>Two Solarite Power Talons (Power Weapons with Shred). The bearer receives the normal +1 Attack for fighting with two close combat weapons.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="3aa6-6983-10fb-478b" name="Pair of Solarite Power Talons" hidden="false" targetId="f17a-8953-093f-317f" type="profile" />
