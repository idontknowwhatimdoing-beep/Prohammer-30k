<rules>
<rule id="e797-0897-45f0-edf3" name="Animus Speculum" hidden="false">
<description>For every Psyker model within 12" of the Culexus, increase the weapon's Assault value by +1.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="13c0-1dce-0b13-aa80" name="Animus Speculum" hidden="false" targetId="d10e-9ccc-18cf-170c" type="profile" />
