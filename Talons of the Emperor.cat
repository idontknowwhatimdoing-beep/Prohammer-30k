<selectionEntry id="0bd3-ac43-7200-bff0" name="Paragon Spear" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="2887-675c-b934-790f" name="Paragon Spear" hidden="false">
<description>A Two-handed Power Weapon which grants the bearer +2 Strength. For every unmodified roll of 6 To Hit, the bearer immediately makes one additional attack (these cannot generate further attacks). An unmodified roll of 6 To Wound inflicts a Massive Wound. Incorporates a Guardian Spear Boltgun.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="8b54-8bad-4c6e-ec6f" name="Paragon Spear" hidden="false" targetId="37e8-ead3-a959-074c" type="profile" />
