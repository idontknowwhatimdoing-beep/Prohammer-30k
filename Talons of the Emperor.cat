<selectionEntry id="d6bb-8702-53ed-414e" name="Psyk-out Grenades" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="1a1f-90f9-e93c-eb05" name="Psyk-out Grenades" hidden="false">
<description>Thrown instead of firing another weapon, range 6". Roll To Hit as normal; only affects Psykers. A Psyker hit must take a Leadership test on 2D6; for every point by which it is failed, the Psyker/unit suffers one wound (saves allowed).</description>
</rule>
</rules>
