<selectionEntry id="9133-643f-4225-1d17" name="Meridian Power Blades" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="eea6-44ed-6986-9b55" name="Meridian Power Blades" hidden="false">
<description>At the beginning of each Assault phase, select one fighting style. MEASURED STRIKE: the model makes only one Attack, resolved at Strength 10, ignoring Armour Saves and inflicting a Massive Wound if successful. LETHAL PRECISION: attacks are resolved at +1 Strength and count as Power Weapon attacks; an unmodified 6 To Wound inflicts a Massive Wound. STORM OF BLADES: attacks count as Power Weapon attacks and the bearer receives +2 Attacks for that Assault phase.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="68ce-5bfb-d1bd-cf92" name="Meridian Power Blades - Measured Strike" hidden="false" targetId="c5df-5af1-61b9-f722" type="profile" />
<infoLink id="c422-beb8-ec48-2e9d" name="Meridian Power Blades - Lethal Precision" hidden="false" targetId="484e-d9c4-2695-db55" type="profile" />
<infoLink id="f942-07df-bd31-59e6" name="Meridian Power Blades - Storm of Blades" hidden="false" targetId="0da4-44b8-35da-4670" type="profile" />
<infoLink id="18db-141e-9f35-2a9a" name="Massive Wound" hidden="false" targetId="600a-263a-03a1-a3b9" type="rule" />
</infoLinks>
<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="0" />
</costs>
</selectionEntry>
<selectionEntry id="8f9c-4056-ae7e-d471" name="The Apollonian Spear" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="25db-3191-0ecb-2c7a" name="The Apollonian Spear" hidden="false">
<description>A Two-handed Power Weapon. Attacks are resolved at +1 Strength, increased to +2 Strength on a turn in which Valdor charges. Every unmodified 6 To Hit generates one additional attack (these cannot generate further attacks). Molecular Severance. Incorporates a Hyper-velocity Bolter.</description>
</rule>
</rules>
