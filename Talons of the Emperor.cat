<selectionEntry id="b1f2-b11e-2a6f-46a1" name="Augury Scanner" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="9893-4f0f-04ec-685b" name="Augury Scanner" hidden="false">
