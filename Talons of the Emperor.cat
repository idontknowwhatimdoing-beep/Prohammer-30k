<selectionEntry id="48ae-5c18-d7bb-4ac2" name="Plasma Grenades" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="7fb8-698b-d67b-8e7c" name="Plasma Grenades" hidden="false">
<description>ASSAULT/FRAG/PLASMA GRENADES: Any model equipped with assault, frag, or plasma grenades (or other equipment that provides a similar effect) that charged into the melee combat this turn ignores the initiative penalty for charging through cover (the models attack at its normal initiative value).</description>
</rule>
</rules>
