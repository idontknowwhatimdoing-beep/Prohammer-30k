<selectionEntry id="e418-6d2f-7d8f-c465" name="Solarite Power Talon" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="c425-e89b-b158-606d" name="Solarite Power Talon" hidden="false">
<description>A Power Weapon with the Shred special rule. A model with a pair of Solarite Power Talons receives the normal +1 Attack for fighting with two close combat weapons.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="f5e9-33c5-0406-cef1" name="Solarite Power Talon" hidden="false" targetId="0115-4fa9-b660-03fd" type="profile" />
