<selectionEntry id="a215-f6b3-bbc4-3cb8" name="Hookfang" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="69f2-2e79-ab0c-b707" name="Hookfang" hidden="false">
<description>A close combat weapon with Poisoned (3+) and Rending. THE VENUM: a model suffering one or more unsaved wounds from it must take a Toughness test at the end of each subsequent Battle Round; if failed it suffers one Wound with no Armour or Invulnerable Saves. A model may only be affected once; the effect lasts the battle.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="961a-36a3-07c7-a684" name="Hookfang" hidden="false" targetId="1381-3ae4-48b6-88ef" type="profile" />
