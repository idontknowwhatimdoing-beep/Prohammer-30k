<selectionEntry id="0af4-ca70-dbd8-f8e9" name="C'tan Phase Sword" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="29b5-f88b-2f14-3daf" name="C'tan Phase Sword" hidden="false">
<description>Counts as a Power Weapon. Neither Armour Saves nor Invulnerable Saves may be taken against wounds it causes.</description>
</rule>
</rules>
