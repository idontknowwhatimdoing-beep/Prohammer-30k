<rules>
<rule id="1b44-65e3-7531-abda" name="Sentinel Warblade" hidden="false">
<description>A Power Weapon incorporating a Sentinel Warblade Boltgun. This weapon may also be fired when making Snap Shots at BS2.</description>
</rule>
</rules>
