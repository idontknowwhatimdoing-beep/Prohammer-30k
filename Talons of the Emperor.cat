<rules>
<rule id="e25e-28e1-a0df-825e" name="Pyrithite Spear" hidden="false">
<description>Follows all of the rules for a Guardian Spear but replaces its built-in boltgun with a Pyrithite Weapon.</description>
</rule>
</rules>
