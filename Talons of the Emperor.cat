<selectionEntry id="2237-e3c2-1705-4da3" name="Venatari Lance" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="4cf0-0e98-a0d0-49d2" name="Venatari Lance" hidden="false">
<description>A Two-handed Power Weapon. On a turn in which the bearer charges, its attacks are resolved at +1 Strength. Every unmodified 6 To Hit generates one additional attack (these cannot generate further attacks). Incorporates an Archaeotech Repeater.</description>
</rule>
</rules>
