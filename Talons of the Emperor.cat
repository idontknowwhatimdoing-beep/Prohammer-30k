<infoLink id="5032-f01e-62a7-60f4" name="Modified Rending" hidden="false" targetId="dc51-ba7c-333c-a504" type="rule" />
</infoLinks>
<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="0" />
</costs>
</selectionEntry>
<selectionEntry id="3f15-34ae-3654-4a96" name="Paired Laspistols" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="5df7-c74f-2c18-aea5" name="Paired Laspistols" hidden="false">
<description>The Vanus may fire both Laspistols during the Shooting phase at the same enemy unit.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="bcfc-d94b-fbeb-a8cb" name="Laspistol" hidden="false" targetId="2195-033b-77ab-993e" type="profile" />
</infoLinks>
