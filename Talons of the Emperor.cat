<rules>
<rule id="3e44-6d7d-0c31-d4ed" name="Adrasite Spear" hidden="false">
<description>Follows all of the rules for a Guardian Spear but replaces its built-in boltgun with an Adrasite Weapon.</description>
</rule>
</rules>
