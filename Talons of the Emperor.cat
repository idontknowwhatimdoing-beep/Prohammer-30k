</costs>
</selectionEntry>
<selectionEntry id="0445-23f9-a11d-b58c" name="Neural Shredder" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="a6d0-3610-2419-52c3" name="Neural Shredder" hidden="false">
<description>When rolling To Wound, use the target's Leadership instead of its Toughness. Against vehicles, do not roll for Armour Penetration; if the vehicle is hit, roll a D3 directly on the Glancing Hit table (no modifiers).</description>
</rule>
</rules>
<infoLinks>
<infoLink id="9fa0-3884-7c79-778c" name="Neural Shredder" hidden="false" targetId="a331-8b48-5e0d-b9c3" type="profile" />
</infoLinks>
<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="0" />
</costs>
</selectionEntry>
<selectionEntry id="9f80-1ab9-490f-6e4e" name="Neuro-Gauntlet" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="d3ae-bf0e-35b9-e1be" name="Neuro-Gauntlet" hidden="false">
<description>A close combat weapon. Each hit wounds a non-vehicle model on a 4+ regardless of Toughness and ignores Armour Saves (Invulnerable Saves allowed). Against vehicles, each hit causes a Glancing Hit on an unmodified D6 roll of 6.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="c0ce-cc11-e709-555c" name="Neuro-Gauntlet" hidden="false" targetId="3173-0903-3b92-8bb0" type="profile" />
</infoLinks>
<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="0" />
</costs>
</selectionEntry>
