<selectionEntry id="63b2-cbd9-86cf-353e" name="Machinator Array" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="a524-6e17-3326-8d52" name="Machinator Array" hidden="false">
<description>+1 Toughness, Night Vision and +2 to Battlesmith repair rolls. Incorporates a Flamer and an Inferno Pistol: the bearer may fire both instead of another ranged weapon, or one of them and one other ranged weapon. Also makes two additional close-combat attacks each Assault phase with the Machinator Array profile.</description>
</rule>
</rules>
