<selectionEntry id="d60b-3f04-a6b0-5846" name="Combi-weapon" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="83f8-3e11-1ea7-975c" name="Combi-weapon" hidden="false">
<description>A Combi-weapon consists of a Bolter and a secondary weapon. The Bolter may be fired normally throughout the battle; the secondary weapon may be fired once per battle. Both may not be fired in the same Shooting phase. (The secondary weapon is not specified in the Lords of War book.)</description>
</rule>
</rules>
