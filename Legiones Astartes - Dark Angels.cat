</characteristics>
</profile>
<profile id="47fb-b088-c6a9-b78b" name="Volkite Caliver" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">30"</characteristic>
