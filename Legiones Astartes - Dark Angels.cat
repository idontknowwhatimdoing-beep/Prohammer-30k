<infoLinks>
<infoLink id="5f2e-7004-d42a-deaa" name="The Blade (one-handed)" hidden="false" targetId="3a80-c2e2-93fc-40eb" type="profile" />
<infoLink id="f522-fec3-6725-5e78" name="The Blade (two-handed)" hidden="false" targetId="731a-12fa-48f9-1fdc" type="profile" />
<infoLink id="f035-afaa-7294-0ba4" name="The Blade" hidden="false" targetId="67ac-d053-8263-6d2f" type="rule" />
