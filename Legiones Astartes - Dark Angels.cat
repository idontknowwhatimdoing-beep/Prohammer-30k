<selectionEntry id="280c-d526-7401-f77a" name="Missile Launcher with Suspensor Web, Rad Missiles and Stasis Missiles" hidden="false" collective="false" import="true" type="upgrade">
<infoLinks>
<infoLink id="2e92-3633-eb1b-e80f" name="Missile Launcher - Frag" hidden="false" targetId="d426-a0a1-de23-7a11" type="profile" />
<infoLink id="0737-1a35-3bde-5943" name="Missile Launcher - Krak" hidden="false" targetId="82b3-06a2-9ac3-9ac1" type="profile" />
<infoLink id="76cf-e85b-5ea8-e09e" name="Rad Missile" hidden="false" targetId="9103-f8f6-64f4-2c87" type="profile" />
<infoLink id="8747-f366-0ff1-3c29" name="Stasis Shell - Missile" hidden="false" targetId="40e7-a614-800e-1ef2" type="profile" />
<infoLink id="e04f-d394-93f1-5fbb" name="Suspensor Web" hidden="false" targetId="081d-6495-cef7-005a" type="rule" />
<infoLink id="fd13-a39d-351f-deb8" name="Rad-phage" hidden="false" targetId="edc5-aeff-99e9-3908" type="rule" />
