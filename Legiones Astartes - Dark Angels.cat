<characteristic name="Capacity" typeId="43e8-af23-5b9c-f1d8">6 models</characteristic>
<characteristic name="Access Points" typeId="bd35-f8fa-db6e-e920">One on each side and one at the rear</characteristic>
<characteristic name="Fire Points" typeId="d703-d9d3-280c-8462">None</characteristic>
</characteristics>
</profile>
</profiles>
