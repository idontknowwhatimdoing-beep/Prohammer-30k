<entryLink id="34c5-d6e4-6042-1da9" name="Searchlight" hidden="false" collective="false" import="true" targetId="3941-9fef-114f-2d9e" type="selectionEntry">
<constraints>
<constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1bb3-4304-b5bc-fbb5" type="min" />
<constraint automatic="true" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fb8c-dd27-8252-925b" type="max" />
</constraints>
</entryLink>
