</characteristics>
</profile>
<profile id="3db6-378f-83f5-4b40" name="Heavy Flamer" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">Template</characteristic>
<characteristic name="S" typeId="6204-806b-a18a-c0be">5</characteristic>
<characteristic name="AP" typeId="964e-6f66-dcaa-247a">4</characteristic>
<characteristic name="Type" typeId="54df-9f85-8d55-7440">Assault 1</characteristic>
</characteristics>
</profile>
<profile id="beec-9cca-b69e-3315" name="Plasma Cannon" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">36"</characteristic>
