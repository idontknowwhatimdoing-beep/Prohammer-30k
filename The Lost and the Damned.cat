<infoLinks>
<infoLink id="dcfd-1b57-6c6f-833f" name="Pariah Flamer" hidden="false" targetId="f1d4-8c16-6475-c3be" type="profile" />
<infoLink id="108d-66eb-e889-3d39" name="Pariah Flamer - Overpressure" hidden="false" targetId="0a67-fbbd-7874-ad5d" type="profile" />
