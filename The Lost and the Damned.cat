<infoLinks>
<infoLink id="bfb1-ea44-e4b7-ae95" name="Grenade Launcher - Frag" hidden="false" targetId="d16f-d687-a4ec-e309" type="profile" />
<infoLink id="eebb-fe5d-7015-9e2e" name="Grenade Launcher - Krak" hidden="false" targetId="eab9-73c4-dccb-bd64" type="profile" />
</infoLinks>
<costs>
