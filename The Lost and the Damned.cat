<selectionEntry id="ffb5-69c8-8490-1f9d" name="Preceptor of the Sigillite" hidden="false" collective="false" import="true" type="unit">
<modifiers>
<modifier type="set" field="hidden" value="true">
<conditions>
<condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="ecf1-4754-7376-85d6" type="instanceOf" />
</conditions>
</modifier>
<modifier type="add" field="error" value="Agents of the Sigillite may only be included alongside a Loyalist Primary Detachment.">
<conditionGroups>
<conditionGroup type="or">
<conditions>
<condition field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="267b-12c2-839b-a93a" type="atLeast" />
<condition field="selections" scope="roster" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="af50-de01-cc93-f43e" type="equalTo" />
</conditions>
</conditionGroup>
</conditionGroups>
</modifier>
<modifier type="add" field="error" value="A force using the Orphans of War or The Alien Brotherhood Oath of Moment may not include Agents of the Sigillite.">
<conditionGroups>
<conditionGroup type="or">
<conditions>
<condition field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="2e97-7126-3f8b-420b" type="atLeast" />
<condition field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="59a3-8abf-0e0f-91fb" type="atLeast" />
</conditions>
</conditionGroup>
</conditionGroups>
</modifier>
<modifier type="add" field="error" value="An army may never contain more than one Agents of the Sigillite Detachment (one HQ choice).">
<conditionGroups>
<conditionGroup type="or">
<conditions>
<condition field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b46d-5293-9915-fcf4" type="greaterThan" />
</conditions>
</conditionGroup>
</conditionGroups>
</modifier>
<modifier type="add" field="error" value="A Preceptor in Terminator Armour may not keep a Bolt Pistol - replace it.">
<conditionGroups>
<conditionGroup type="and">
<conditions>
<condition field="selections" scope="ffb5-69c8-8490-1f9d" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a6a2-abea-01b2-ad81" type="atLeast" />
<condition field="selections" scope="ffb5-69c8-8490-1f9d" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="10e2-6917-e765-7495" type="atLeast" />
</conditions>
</conditionGroup>
</conditionGroups>
</modifier>
</modifiers>
