<constraint automatic="true" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3e6d-cd7c-ac28-fa9e" type="max" />
</constraints>
<rules>
<rule id="df93-921e-95ed-9f95" name="Battle-automata Carriage (Mechanicum only)" hidden="false">
<description>Mechanicum only: an Arvus Lighter selected by a Mechanicum army may be modified to carry Battle-automata. If this upgrade is taken, it may transport either 1 Castellax Battle-Automata, or up to 2 Vorax Battle-Automata. An Arvus modified in this manner may not transport any other models.</description>
</rule>
</rules>
<costs>
<cost name="pts" typeId="pts0-0000-0000-0001" value="20" />
</costs>
</selectionEntry>
