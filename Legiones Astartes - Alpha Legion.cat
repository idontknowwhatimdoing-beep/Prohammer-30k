</selectionEntry>
<selectionEntry id="90a9-e935-86a8-e883" name="Pale Spear" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="656a-cf3d-c471-905f" name="Pale Spear" hidden="false">
<description>A Two-Handed Power Weapon resolved at Alpharius' normal Strength with Armourbane. Any unsaved Wound it inflicts on a model without the Primarch special rule becomes a Massive Wound and inflicts D3 Wounds instead of one.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="0a5a-648b-e734-c52c" name="Pale Spear" hidden="false" targetId="8985-cf6f-08cd-5a5e" type="profile" />
