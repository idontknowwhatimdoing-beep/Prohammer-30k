<selectionEntry id="3e60-217f-eb6b-3d79" name="Rime-shard" hidden="false" collective="false" import="true" type="upgrade">
<rules>
<rule id="9089-cc56-6f74-b3cd" name="Rime-shard" hidden="false">
<description>Counts as a Master-crafted Power Weapon; attacks are resolved at +2 Strength. Two-handed: no bonus Attack for two close-combat weapons.</description>
</rule>
</rules>
<infoLinks>
<infoLink id="df61-5eef-5b91-f090" name="Rime-shard" hidden="false" targetId="aa94-75d4-cb81-a674" type="profile" />
