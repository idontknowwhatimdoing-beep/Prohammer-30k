<selectionEntry id="d8ad-7c96-ae1d-5803" name="0-1 Legion Artillery Tank Squadron" hidden="false" collective="false" import="true" type="unit">
<modifiers>
<modifier type="add" field="error" value="An Artillery Tank Squadron contains 1-3 vehicles, all of the same type.">
<conditionGroups>
<conditionGroup type="or">
<conditions>
<condition field="selections" scope="d8ad-7c96-ae1d-5803" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" type="lessThan" />
<condition field="selections" scope="d8ad-7c96-ae1d-5803" value="3" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" type="greaterThan" />
</conditions>
</conditionGroup>
</conditionGroups>
</modifier>
