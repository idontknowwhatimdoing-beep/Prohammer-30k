    <profile id="bd42-4fdf-fdc2-185f" name="Volkite Serpenta" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="4b89-f4f0-2a22-1135">10"</characteristic>
