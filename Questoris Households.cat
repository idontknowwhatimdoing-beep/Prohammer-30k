<profile id="8588-02b0-dc47-2f34" name="Thunderstrike Gauntlet" hidden="false" typeId="34e7-5c9b-31e6-d0ce" typeName="Weapon">
<characteristics>
<characteristic name="Range" typeId="4b89-f4f0-2a22-1135">-</characteristic>
